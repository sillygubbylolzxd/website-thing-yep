    {
      "tier": "vip",
      "name": "effect",
      "desc": "Apply an effect to a player, or pick clear to remove effects instead.",
      "struct": [
        {
          "name": "effect type",
          "type": "select",
          "optionName": "effectsWithClear",
          "hint": "Pick clear to remove effects instead of applying one."
        },
        {
          "name": "target",
          "type": "select",
          "optionName": "targetPlayers"
        },
        {
          "name": "duration",
          "type": "number",
          "optional": true,
          "hint": "Optional, but if you leave it empty the effect ends instantly."
        },
        {
          "name": "modifier",
          "type": "number",
          "optional": true
        }
      ],
      "alt": {
        "when": {
          "index": 0,
          "value": "clear"
        },
        "struct": [
          {
            "name": "effect type",
            "type": "select",
            "optionName": "effectsWithClear",
            "hint": "Pick clear to remove effects instead of applying one."
