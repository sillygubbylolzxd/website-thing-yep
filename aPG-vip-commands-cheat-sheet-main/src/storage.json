      ]
    },
    {
      "tier": "vip",
      "name": "event",
      "desc": "Summon an event. Pick from every plate, arena, big, player, class, disaster and rare event.",
      "struct": [
        {
          "name": "event name",
          "type": "select",
          "optionName": "events",
          "hint": "Rare, mini-disaster and seasonal events are not separate lists. Each one sits inside the category it belongs to, shown indented."
