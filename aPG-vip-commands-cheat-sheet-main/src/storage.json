    {
      "tier": "vip",
      "name": "admin",
      "desc": "Temporarily give a player admin while they are in the server. It does not save.",
      "struct": [
        {
          "name": "target",
          "type": "select",
          "optionName": "targetPlayers"
        }
      ]
    },
    {
      "tier": "vip",
      "name": "unadmin",
      "desc": "Take temporary admin away from a player.",
