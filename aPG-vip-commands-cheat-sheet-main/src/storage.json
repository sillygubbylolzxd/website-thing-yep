          {
            "name": "target",
            "type": "select",
            "optionName": "targetPlayers"
          },
          {
            "name": "effect to remove",
            "type": "select",
            "optionName": "effects",
            "optional": true,
            "hint": "Leave empty to remove every effect, or pick one to remove only that effect."
          }
